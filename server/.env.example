APP_NAME="Breakscale Simulator API"
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
# Neon: paste the actual connection string from the Connect dialog.
# postgresql:// URLs and sslmode=require are normalized for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Local HTTP only; use true with HTTPS in deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_ACTIVE_SIMULATIONS=2
MAX_REQUESTS=10000
MAX_WS_MESSAGE_BYTES=262144
